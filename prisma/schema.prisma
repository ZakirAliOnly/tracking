generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id               String            @id @default(uuid())
  name             String
  createdAt        DateTime          @default(now()) @map("created_at")
  users            User[]
  customers        Customer[]
  vehicles         Vehicle[]
  devices          Device[]
  suppliers        Supplier[]
  accounts         Account[]
  installations    Installation[]
  renewals         Renewal[]
  expenses         Expense[]
  notifications    Notification[]
  purchaseInvoices PurchaseInvoice[]
  supplierPayments SupplierPayment[]
  fundTransfers    FundTransfer[]

  @@map("organizations")
}

model User {
  id           String    @id @default(uuid())
  orgId        String    @map("org_id")
  fullName     String    @map("full_name")
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         String    @default("staff")
  createdAt    DateTime  @default(now()) @map("created_at")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  expenses     Expense[]

  @@map("users")
}

model Customer {
  id            String         @id @default(uuid())
  orgId         String         @map("org_id")
  name          String
  phone         String
  address       String?
  password      String?
  remarks       String?
  createdAt     DateTime       @default(now()) @map("created_at")
  organization  Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contacts      Contact[]
  vehicles      Vehicle[]
  installations Installation[]

  @@map("customers")
}

// Optional — only populated when a customer has multiple named contacts
model Contact {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  name       String
  mobile     String
  position   Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("contacts")
}

model Vehicle {
  id             String         @id @default(uuid())
  orgId          String         @map("org_id")
  customerId     String         @map("customer_id")
  registrationNo String         @map("registration_no")
  description    String?
  make           String?
  model          String?
  engineNo       String?        @map("engine_no")
  chassisNo      String?        @map("chassis_no")
  colour         String?
  createdAt      DateTime       @default(now()) @map("created_at")
  organization   Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  installations  Installation[]

  @@unique([orgId, registrationNo])
  @@map("vehicles")
}

model Supplier {
  id               String            @id @default(uuid())
  orgId            String            @map("org_id")
  name             String
  contactName      String?           @map("contact_name")
  phone            String?
  address          String?
  supplies         String?
  openingOwed      Decimal           @default(0) @map("opening_owed") @db.Decimal(12, 2)
  status           String            @default("active")
  createdAt        DateTime          @default(now()) @map("created_at")
  organization     Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  devices          Device[]
  expenses         Expense[]
  purchaseInvoices PurchaseInvoice[]
  payments         SupplierPayment[]

  @@map("suppliers")
}

model Device {
  id               String            @id @default(uuid())
  orgId            String            @map("org_id")
  supplierId       String?           @map("supplier_id")
  imeiNo           String?           @map("imei_no")
  gsmNo            String?           @map("gsm_no")
  gsmNoAlt         String?           @map("gsm_no_alt")
  fmModule         String?           @map("fm_module")
  cutOff           String?           @map("cut_off")
  status           String            @default("in_stock")
  quantity         Int               @default(0)
  costPrice        Decimal?          @map("cost_price") @db.Decimal(12, 2)
  salePrice        Decimal?          @map("sale_price") @db.Decimal(12, 2)
  createdAt        DateTime          @default(now()) @map("created_at")
  organization     Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  supplier         Supplier?         @relation(fields: [supplierId], references: [id])
  installations    Installation[]
  installationLines InstallationDevice[]
  purchaseInvoices PurchaseInvoice[]

  @@map("devices")
}

model Account {
  id               String            @id @default(uuid())
  orgId            String            @map("org_id")
  name             String
  type             String            @default("cash")
  details          Json?
  openingBalance   Decimal           @default(0) @map("opening_balance") @db.Decimal(12, 2)
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at")
  organization     Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  installations    Installation[]
  renewals         Renewal[]
  expenses         Expense[]
  supplierPayments SupplierPayment[]
  purchaseInvoices PurchaseInvoice[]
  transfersFrom    FundTransfer[]    @relation("transfers_from")
  transfersTo      FundTransfer[]    @relation("transfers_to")

  @@map("accounts")
}

model Installation {
  id               String       @id @default(uuid())
  orgId            String       @map("org_id")
  customerId       String       @map("customer_id")
  vehicleId        String       @map("vehicle_id")
  deviceId         String?      @map("device_id")
  accountId        String?      @map("account_id")
  installationDate DateTime     @map("installation_date") @db.Date
  received         Boolean      @default(false)
  simNo            String?      @map("sim_no")
  /// Plain reference text kept on the installation itself — not linked to a
  /// Stock device, purely informational (unlike the CSV import's IMEI, which
  /// matches or creates a real Device row)
  gsmNo            String?      @map("gsm_no")
  fmModule         String?      @map("fm_module")
  cutOff           String?      @map("cut_off")
  imeiNo           String?      @map("imei_no")
  installationPay  Decimal      @default(0) @map("installation_pay") @db.Decimal(12, 2)
  simPayment       Decimal      @default(0) @map("sim_payment") @db.Decimal(12, 2)
  devicePayment    Decimal      @default(0) @map("device_payment") @db.Decimal(12, 2)
  netPayment       Decimal      @default(0) @map("net_payment") @db.Decimal(12, 2)
  /// Net left over after SIM, device and expenses — entered by hand, never computed
  otherAmount      Decimal      @default(0) @map("other_amount") @db.Decimal(12, 2)
  totalAmount      Decimal?     @map("total_amount") @db.Decimal(12, 2)
  discount         Decimal      @default(0) @db.Decimal(12, 2)
  amountPaid       Decimal      @default(0) @map("amount_paid") @db.Decimal(12, 2)
  nextRenewalDate  DateTime     @map("next_renewal_date") @db.Date
  status           String       @default("active")
  createdAt        DateTime     @default(now()) @map("created_at")
  organization     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer         Customer     @relation(fields: [customerId], references: [id])
  vehicle          Vehicle      @relation(fields: [vehicleId], references: [id])
  device           Device?      @relation(fields: [deviceId], references: [id])
  account          Account?     @relation(fields: [accountId], references: [id])
  renewals         Renewal[]
  devices          InstallationDevice[]

  @@map("installations")
}

/// Every device fitted on an installation. `installations.device_id` still holds
/// the first one so older rows and read paths keep working.
model InstallationDevice {
  id             String       @id @default(uuid())
  installationId String       @map("installation_id")
  deviceId       String       @map("device_id")
  quantity       Int          @default(1)
  unitPrice      Decimal      @default(0) @map("unit_price") @db.Decimal(12, 2)
  createdAt      DateTime     @default(now()) @map("created_at")
  installation   Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  device         Device       @relation(fields: [deviceId], references: [id])

  @@index([installationId])
  @@index([deviceId])
  @@map("installation_devices")
}

model Renewal {
  id              String       @id @default(uuid())
  orgId           String       @map("org_id")
  installationId  String       @map("installation_id")
  accountId       String?      @map("account_id")
  received        Boolean      @default(false)
  amount          Decimal      @default(0) @db.Decimal(12, 2)
  simOsting       Decimal      @default(0) @map("sim_osting") @db.Decimal(12, 2)
  net             Decimal      @default(0) @db.Decimal(12, 2)
  other           Decimal      @default(0) @db.Decimal(12, 2)
  otherNote       String?      @map("other_note")
  renewedAt       DateTime     @map("renewed_at") @db.Date
  nextRenewalDate DateTime     @map("next_renewal_date") @db.Date
  createdAt       DateTime     @default(now()) @map("created_at")
  organization    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  installation    Installation @relation(fields: [installationId], references: [id])
  account         Account?     @relation(fields: [accountId], references: [id])

  @@map("renewals")
}

model Expense {
  id           String       @id @default(uuid())
  orgId        String       @map("org_id")
  category     String
  description  String?
  amount       Decimal      @db.Decimal(12, 2)
  accountId    String?      @map("account_id")
  supplierId   String?      @map("supplier_id")
  spentAt      DateTime     @map("spent_at") @db.Date
  receiptUrl   String?      @map("receipt_url")
  createdBy    String       @map("created_by")
  createdAt    DateTime     @default(now()) @map("created_at")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  account      Account?     @relation(fields: [accountId], references: [id])
  supplier     Supplier?    @relation(fields: [supplierId], references: [id])
  user         User         @relation(fields: [createdBy], references: [id])

  @@map("expenses")
}

model PurchaseInvoice {
  id          String       @id @default(uuid())
  orgId       String       @map("org_id")
  supplierId  String       @map("supplier_id")
  deviceId    String       @map("device_id")
  accountId   String?      @map("account_id")
  quantity    Int
  costPrice   Decimal      @map("cost_price") @db.Decimal(12, 2)
  salePrice   Decimal?     @map("sale_price") @db.Decimal(12, 2)
  totalAmount Decimal      @map("total_amount") @db.Decimal(12, 2)
  amountPaid  Decimal      @default(0) @map("amount_paid") @db.Decimal(12, 2)
  notes       String?
  invoiceDate DateTime     @map("invoice_date") @db.Date
  createdAt   DateTime     @default(now()) @map("created_at")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  supplier    Supplier     @relation(fields: [supplierId], references: [id])
  device      Device       @relation(fields: [deviceId], references: [id])
  account     Account?     @relation(fields: [accountId], references: [id])

  @@map("purchase_invoices")
}

model SupplierPayment {
  id         String       @id @default(uuid())
  orgId      String       @map("org_id")
  supplierId String       @map("supplier_id")
  accountId  String?      @map("account_id")
  amount     Decimal      @db.Decimal(12, 2)
  note       String?
  paidAt     DateTime     @map("paid_at") @db.Date
  createdAt  DateTime     @default(now()) @map("created_at")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  supplier   Supplier     @relation(fields: [supplierId], references: [id])
  account    Account?     @relation(fields: [accountId], references: [id])

  @@map("supplier_payments")
}

model FundTransfer {
  id            String       @id @default(uuid())
  orgId         String       @map("org_id")
  fromId        String       @map("from_id")
  toId          String       @map("to_id")
  amount        Decimal      @db.Decimal(12, 2)
  note          String?
  transferredAt DateTime     @map("transferred_at") @db.Date
  createdAt     DateTime     @default(now()) @map("created_at")
  organization  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  from          Account      @relation("transfers_from", fields: [fromId], references: [id])
  to            Account      @relation("transfers_to", fields: [toId], references: [id])

  @@map("fund_transfers")
}

model Notification {
  id           String       @id @default(uuid())
  orgId        String       @map("org_id")
  type         String
  message      String
  entityId     String?      @map("entity_id")
  isRead       Boolean      @default(false) @map("is_read")
  createdAt    DateTime     @default(now()) @map("created_at")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
